# Copy to .env.local (or .env) and fill in local secrets.
# Never commit real credentials. This file is the only env template in git.

# --- Neon Postgres (required — no file-token fallback) ---
# Create a project at https://console.neon.tech and paste the connection string.
# Use the pooled URI in Vercel if offered; sslmode=require is typical.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# 32-byte key for OAuth token columns (64 hex chars OR 32-byte base64).
# Required in production. ADRUNR_MOCK=1 may omit this (mock-only key).
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (Web application client) ---
# GCP project name (docs only): adrunr-ads-ops
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Google Ads API ---
# Developer token is Test Account access until Basic Access is approved.
GOOGLE_ADS_DEVELOPER_TOKEN=
# MCC / login-customer-id. Hyphens optional. Platform MCC (red4code): 857-080-5596
GOOGLE_ADS_LOGIN_CUSTOMER_ID=857-080-5596
# Optional: persist a refresh token into OAuthConnection on first use (not a file store)
GOOGLE_ADS_REFRESH_TOKEN=
# REST version (override only if you know you need another supported version)
GOOGLE_ADS_API_VERSION=v19

# --- GA4 Data API (readonly stub — soft-fails if unset) ---
GA4_PROPERTY_ID=

# --- App ---
APP_BASE_URL=http://localhost:3000
# Local / CI demo without live Google or LLM calls. Leave empty for real API.
ADRUNR_MOCK=

# --- Search assistant (optional live model) ---
# OpenAI-compatible chat completions. Ignored when ADRUNR_MOCK=1.
# Never commit real keys. Mock heuristic fill works without these.
ADRUNR_LLM_API_KEY=
ADRUNR_LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
ADRUNR_LLM_MODEL=openai/gpt-5.4
