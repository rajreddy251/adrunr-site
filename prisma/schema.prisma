generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  PLATFORM
  AGENCY
}

enum MembershipRole {
  PLATFORM_OPS
  AGENCY_OWNER
  AGENCY_ADMIN
  AGENCY_MANAGER
  AGENT
  VIEWER
  FINANCE
}

enum ClientMemberRole {
  CLIENT_ADMIN
  CLIENT_USER
  CLIENT_VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProviderCategory {
  ADS
  ANALYTICS
  HEATMAP
  OTHER
}

enum ConnectionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  ERROR
}

enum ExternalAccountStatus {
  UNKNOWN
  ENABLED
  CANCELED
  SUSPENDED
  NOT_ENABLED
  DISCONNECTED
}

enum ExternalEntityType {
  CAMPAIGN
  AD_GROUP
  AD
  PROPERTY
  PROJECT
  PIXEL
  OTHER
}

enum CampaignOpKind {
  SEARCH_CREATE
  PMAX_CREATE
  DISPLAY_CREATE
  META_CAMPAIGN_CREATE
  TIKTOK_CAMPAIGN_CREATE
  LINKEDIN_CAMPAIGN_CREATE
  GENERIC_MUTATE
  DEMAND_GEN_CREATE
  VIDEO_CREATE
  SHOPPING_CREATE
}

enum CampaignOpStatus {
  DRAFT
  DRY_RUN_VALIDATED
  APPLIED_PAUSED
  REJECTED
  FAILED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PermissionResource {
  ORGANIZATION
  MEMBERSHIP
  CLIENT
  WORKSPACE
  INTEGRATION_PROVIDER
  OAUTH_CONNECTION
  EXTERNAL_ACCOUNT
  EXTERNAL_ENTITY
  CAMPAIGN_OP
  SEARCH_CAMPAIGN_DRAFT
  DISPLAY_CAMPAIGN_DRAFT
  PERFORMANCE_MAX_CAMPAIGN_DRAFT
  DEMAND_GEN_CAMPAIGN_DRAFT
  VIDEO_CAMPAIGN_DRAFT
  SHOPPING_CAMPAIGN_DRAFT
  SYNC_JOB
  AUDIT_EVENT
  BILLING
}

enum SearchDraftStatus {
  DRAFT
  VALIDATED
  APPLIED
  FAILED
}

enum SearchKeywordMatchType {
  BROAD
  PHRASE
  EXACT
}

enum SearchTargetType {
  GEO
  LANGUAGE
  AUDIENCE
  SCHEDULE
  DEVICE
}

enum SearchBiddingStrategy {
  MANUAL_CPC
  MAXIMIZE_CLICKS
  MAXIMIZE_CONVERSIONS
  TARGET_CPA
  TARGET_ROAS
}

enum DisplayDraftStatus {
  DRAFT
  VALIDATED
  APPLIED
  FAILED
}

enum DisplayBiddingStrategy {
  MANUAL_CPC
  MAXIMIZE_CLICKS
  MAXIMIZE_CONVERSIONS
  TARGET_CPA
  TARGET_ROAS
}

enum DisplayTargetType {
  GEO
  LANGUAGE
}

enum DisplayAudienceKind {
  USER_LIST
  AFFINITY
  IN_MARKET
  CUSTOM
}

enum DisplayAssetKind {
  MARKETING_IMAGE
  SQUARE_MARKETING_IMAGE
  LOGO
  YOUTUBE_VIDEO
}

enum PerformanceMaxDraftStatus {
  DRAFT
  VALIDATED
  APPLIED
  FAILED
}

enum PerformanceMaxBiddingStrategy {
  MAXIMIZE_CONVERSIONS
  MAXIMIZE_CONVERSION_VALUE
  TARGET_CPA
  TARGET_ROAS
}

enum PerformanceMaxTargetType {
  GEO
  LANGUAGE
}

enum PerformanceMaxSignalKind {
  SEARCH_THEME
  USER_LIST
  CUSTOM
}

enum PerformanceMaxAssetKind {
  MARKETING_IMAGE
  SQUARE_MARKETING_IMAGE
  PORTRAIT_MARKETING_IMAGE
  LOGO
  LANDSCAPE_LOGO
  YOUTUBE_VIDEO
}

enum PerformanceMaxListingKind {
  ALL_PRODUCTS
  UNIT
}

enum DemandGenDraftStatus {
  DRAFT
  VALIDATED
  APPLIED
  FAILED
}

enum DemandGenBiddingStrategy {
  MAXIMIZE_CONVERSIONS
  MAXIMIZE_CONVERSION_VALUE
  TARGET_CPA
  TARGET_ROAS
}

enum DemandGenTargetType {
  GEO
  LANGUAGE
}

enum DemandGenAudienceKind {
  USER_LIST
  AFFINITY
  IN_MARKET
  CUSTOM
}

enum DemandGenAssetKind {
  MARKETING_IMAGE
  SQUARE_MARKETING_IMAGE
  PORTRAIT_MARKETING_IMAGE
  LOGO
  YOUTUBE_VIDEO
}

enum VideoDraftStatus {
  DRAFT
  VALIDATED
  APPLIED
  FAILED
}

enum VideoBiddingStrategy {
  MANUAL_CPV
  TARGET_CPM
  MAXIMIZE_CONVERSIONS
  TARGET_CPA
}

enum VideoTargetType {
  GEO
  LANGUAGE
}

enum VideoAudienceKind {
  USER_LIST
  AFFINITY
  IN_MARKET
  CUSTOM
}

enum VideoAssetKind {
  YOUTUBE_VIDEO
  COMPANION_BANNER
  MARKETING_IMAGE
}

enum ShoppingDraftStatus {
  DRAFT
  VALIDATED
  APPLIED
  FAILED
}

enum ShoppingBiddingStrategy {
  MANUAL_CPC
  MAXIMIZE_CLICKS
  MAXIMIZE_CONVERSION_VALUE
  TARGET_ROAS
}

enum ShoppingTargetType {
  GEO
  LANGUAGE
}

enum ShoppingPriority {
  LOW
  MEDIUM
  HIGH
}

enum ShoppingProductGroupKind {
  ALL_PRODUCTS
  UNIT
  SUBDIVISION
}

enum ShoppingListingKind {
  ALL_PRODUCTS
  UNIT
}

enum AssistantMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  CONNECT
  DISCONNECT
  LIST
  DRY_RUN
  APPLY_PAUSED
  INVITE
  ASSIGN
  SYNC
}

model Organization {
  id        String           @id @default(cuid())
  type      OrganizationType @default(AGENCY)
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  clients          Client[]
  workspaces       Workspace[]
  oauthConnections OAuthConnection[]
  externalAccounts ExternalAccount[]
  campaignOps      CampaignOp[]
  searchDrafts     SearchCampaignDraft[]
  displayDrafts    DisplayCampaignDraft[]
  pmaxDrafts       PerformanceMaxCampaignDraft[]
  demandGenDrafts  DemandGenCampaignDraft[]
  videoDrafts      VideoCampaignDraft[]
  shoppingDrafts   ShoppingCampaignDraft[]
  syncJobs         SyncJob[]
  auditEvents      AuditEvent[]
  agentAssignments AgentClientAssignment[]
  assistantThreads AssistantThread[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  imageUrl      String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships       Membership[]
  clientMemberships ClientMembership[]
  invitationsSent   Invitation[]       @relation("InvitationInviter")
  oauthConnections  OAuthConnection[]
  campaignOps       CampaignOp[]
  searchDrafts      SearchCampaignDraft[]
  displayDrafts     DisplayCampaignDraft[]
  pmaxDrafts        PerformanceMaxCampaignDraft[]
  demandGenDrafts   DemandGenCampaignDraft[]
  videoDrafts       VideoCampaignDraft[]
  shoppingDrafts    ShoppingCampaignDraft[]
  changeRequests    ChangeRequest[]
  auditEvents       AuditEvent[]
  agentAssignments  AgentClientAssignment[]
  assistantThreads  AssistantThread[]
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  externalRef    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships      ClientMembership[]
  workspaces       Workspace[]
  externalAccounts ExternalAccount[]
  campaignOps      CampaignOp[]
  searchDrafts     SearchCampaignDraft[]
  displayDrafts    DisplayCampaignDraft[]
  pmaxDrafts       PerformanceMaxCampaignDraft[]
  demandGenDrafts  DemandGenCampaignDraft[]
  videoDrafts      VideoCampaignDraft[]
  shoppingDrafts   ShoppingCampaignDraft[]
  agentAssignments AgentClientAssignment[]
  assistantThreads AssistantThread[]
  clientMemories   ClientMemory[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model ClientMembership {
  id        String           @id @default(cuid())
  clientId  String
  userId    String
  role      ClientMemberRole
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
}

model AgentClientAssignment {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([organizationId, userId])
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaignOps  CampaignOp[]

  @@index([organizationId])
  @@index([clientId])
}

model IntegrationProvider {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  category      ProviderCategory
  isActive      Boolean          @default(true)
  oauthAuthUrl  String?
  oauthTokenUrl String?
  defaultScopes String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  oauthConnections OAuthConnection[]
  externalAccounts ExternalAccount[]
  campaignOps      CampaignOp[]
  syncJobs         SyncJob[]
  changeRequests   ChangeRequest[]
}

model OAuthConnection {
  id                    String           @id @default(cuid())
  organizationId        String
  userId                String?
  providerId            String
  providerAccountEmail  String?
  scopes                String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  tokenType             String           @default("Bearer")
  status                ConnectionStatus @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  revokedAt             DateTime?

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         IntegrationProvider @relation(fields: [providerId], references: [id])
  externalAccounts ExternalAccount[]

  @@index([organizationId, providerId])
  @@index([userId])
}

model ExternalAccount {
  id                String                @id @default(cuid())
  organizationId    String
  clientId          String
  providerId        String
  oauthConnectionId String?
  externalId        String
  displayName       String?
  currencyCode      String?
  timeZone          String?
  isManager         Boolean               @default(false)
  isTest            Boolean               @default(false)
  status            ExternalAccountStatus @default(UNKNOWN)
  parentExternalId  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider        IntegrationProvider @relation(fields: [providerId], references: [id])
  oauthConnection OAuthConnection?    @relation(fields: [oauthConnectionId], references: [id], onDelete: SetNull)
  entities        ExternalEntity[]
  campaignOps     CampaignOp[]
  searchDrafts    SearchCampaignDraft[]
  displayDrafts   DisplayCampaignDraft[]
  pmaxDrafts      PerformanceMaxCampaignDraft[]
  demandGenDrafts DemandGenCampaignDraft[]
  videoDrafts     VideoCampaignDraft[]
  shoppingDrafts  ShoppingCampaignDraft[]
  dryRunJobs      DryRunJob[]
  syncJobs        SyncJob[]

  @@unique([organizationId, providerId, externalId])
  @@index([clientId])
  @@index([providerId])
  @@index([oauthConnectionId])
}

model ExternalEntity {
  id                String             @id @default(cuid())
  organizationId    String
  providerId        String
  externalAccountId String
  entityType        ExternalEntityType
  externalId        String
  displayName       String?
  status            String?
  attributesText    String?
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  externalAccount ExternalAccount @relation(fields: [externalAccountId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalAccountId, entityType, externalId])
  @@index([organizationId, providerId])
}

model CampaignOp {
  id                 String           @id @default(cuid())
  organizationId     String
  clientId           String
  workspaceId        String?
  providerId         String
  externalAccountId  String
  requestedById      String
  kind               CampaignOpKind   @default(SEARCH_CREATE)
  status             CampaignOpStatus @default(DRAFT)
  name               String
  dailyBudgetMicros  BigInt?
  dryRun             Boolean          @default(true)
  confirmPhrase      String?
  requestPayload             String
  responsePayload            String?
  googleValidateOnly         Boolean          @default(true)
  googleCampaignResourceName String?
  searchCampaignDraftId      String?
  displayCampaignDraftId     String?
  pmaxCampaignDraftId        String?
  demandGenCampaignDraftId   String?
  videoCampaignDraftId       String?
  shoppingCampaignDraftId    String?
  errorMessage               String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  appliedAt                  DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace           Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  provider            IntegrationProvider  @relation(fields: [providerId], references: [id])
  externalAccount     ExternalAccount      @relation(fields: [externalAccountId], references: [id], onDelete: Restrict)
  requestedBy         User                 @relation(fields: [requestedById], references: [id])
  searchCampaignDraft      SearchCampaignDraft?          @relation(fields: [searchCampaignDraftId], references: [id], onDelete: SetNull)
  displayCampaignDraft     DisplayCampaignDraft?         @relation(fields: [displayCampaignDraftId], references: [id], onDelete: SetNull)
  pmaxCampaignDraft        PerformanceMaxCampaignDraft?  @relation(fields: [pmaxCampaignDraftId], references: [id], onDelete: SetNull)
  demandGenCampaignDraft   DemandGenCampaignDraft?       @relation(fields: [demandGenCampaignDraftId], references: [id], onDelete: SetNull)
  videoCampaignDraft       VideoCampaignDraft?           @relation(fields: [videoCampaignDraftId], references: [id], onDelete: SetNull)
  shoppingCampaignDraft    ShoppingCampaignDraft?        @relation(fields: [shoppingCampaignDraftId], references: [id], onDelete: SetNull)
  dryRunJobs               DryRunJob[]
  changeRequests           ChangeRequest[]

  @@index([organizationId, status])
  @@index([providerId, externalAccountId])
  @@index([clientId])
  @@index([searchCampaignDraftId])
  @@index([displayCampaignDraftId])
  @@index([pmaxCampaignDraftId])
  @@index([demandGenCampaignDraftId])
  @@index([videoCampaignDraftId])
  @@index([shoppingCampaignDraftId])
}

model SearchCampaignDraft {
  id                         String                @id @default(cuid())
  organizationId             String
  clientId                   String
  externalAccountId          String
  createdById                String
  name                       String
  dailyBudgetMicros          BigInt
  biddingStrategy            SearchBiddingStrategy @default(MANUAL_CPC)
  enhancedCpcEnabled         Boolean               @default(false)
  targetCpaMicros            BigInt?
  targetRoasText             String?
  targetGoogleSearch         Boolean               @default(true)
  targetSearchNetwork        Boolean               @default(true)
  targetContentNetwork       Boolean               @default(false)
  targetPartnerSearchNetwork Boolean               @default(false)
  startDate                  String?
  endDate                    String?
  statusDraft                SearchDraftStatus     @default(DRAFT)
  googleCampaignResourceName String?
  campaignOpId               String?
  notesText                  String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  externalAccount ExternalAccount      @relation(fields: [externalAccountId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  campaignOps      CampaignOp[]
  adGroups         SearchAdGroupDraft[]
  targets          SearchTargetDraft[]
  assistantThreads AssistantThread[]

  @@index([organizationId, statusDraft])
  @@index([clientId])
  @@index([externalAccountId])
  @@index([createdById])
}

model SearchAdGroupDraft {
  id                       String   @id @default(cuid())
  draftId                  String
  name                     String
  defaultBidMicros         BigInt
  sortOrder                Int      @default(0)
  googleAdGroupResourceName String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  draft    SearchCampaignDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  keywords SearchKeywordDraft[]
  ads      SearchAdDraft[]

  @@index([draftId, sortOrder])
}

model SearchKeywordDraft {
  id                        String                 @id @default(cuid())
  adGroupDraftId            String
  text                      String
  matchType                 SearchKeywordMatchType @default(PHRASE)
  bidMicros                 BigInt?
  isNegative                Boolean                @default(false)
  googleCriterionResourceName String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  adGroup SearchAdGroupDraft @relation(fields: [adGroupDraftId], references: [id], onDelete: Cascade)

  @@index([adGroupDraftId])
}

model SearchAdDraft {
  id                    String   @id @default(cuid())
  adGroupDraftId        String
  headlinesText         String
  descriptionsText      String
  finalUrl              String
  path1                 String?
  path2                 String?
  googleAdResourceName  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  adGroup SearchAdGroupDraft @relation(fields: [adGroupDraftId], references: [id], onDelete: Cascade)

  @@index([adGroupDraftId])
}

model SearchTargetDraft {
  id            String           @id @default(cuid())
  draftId       String
  type          SearchTargetType
  valueText     String
  criterionText String
  included      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  draft SearchCampaignDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, type])
}

model DisplayCampaignDraft {
  id                         String                 @id @default(cuid())
  organizationId             String
  clientId                   String
  externalAccountId          String
  createdById                String
  name                       String
  dailyBudgetMicros          BigInt
  biddingStrategy            DisplayBiddingStrategy @default(MANUAL_CPC)
  enhancedCpcEnabled         Boolean                @default(false)
  targetCpaMicros            BigInt?
  targetRoasText             String?
  startDate                  String?
  endDate                    String?
  statusDraft                DisplayDraftStatus     @default(DRAFT)
  googleCampaignResourceName String?
  campaignOpId               String?
  notesText                  String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  externalAccount  ExternalAccount        @relation(fields: [externalAccountId], references: [id], onDelete: Restrict)
  createdBy        User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  campaignOps      CampaignOp[]
  adGroups         DisplayAdGroupDraft[]
  targets          DisplayTargetDraft[]
  audiences        DisplayAudienceDraft[]
  assistantThreads AssistantThread[]

  @@index([organizationId, statusDraft])
  @@index([clientId])
  @@index([externalAccountId])
  @@index([createdById])
}

model DisplayAdGroupDraft {
  id                        String   @id @default(cuid())
  draftId                   String
  name                      String
  defaultBidMicros          BigInt
  sortOrder                 Int      @default(0)
  googleAdGroupResourceName String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  draft DisplayCampaignDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  ads   DisplayAdDraft[]

  @@index([draftId, sortOrder])
}

model DisplayAdDraft {
  id                   String   @id @default(cuid())
  adGroupDraftId       String
  headlinesText        String
  longHeadline         String
  descriptionsText     String
  businessName         String
  finalUrl             String
  googleAdResourceName String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  adGroup DisplayAdGroupDraft @relation(fields: [adGroupDraftId], references: [id], onDelete: Cascade)
  assets  DisplayAssetDraft[]

  @@index([adGroupDraftId])
}

model DisplayAssetDraft {
  id                 String           @id @default(cuid())
  adDraftId          String
  kind               DisplayAssetKind
  urlText            String
  assetResourceName  String?
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  ad DisplayAdDraft @relation(fields: [adDraftId], references: [id], onDelete: Cascade)

  @@index([adDraftId, kind])
}

model DisplayAudienceDraft {
  id            String              @id @default(cuid())
  draftId       String
  kind          DisplayAudienceKind
  valueText     String
  criterionText String
  included      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  draft DisplayCampaignDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, kind])
}

model DisplayTargetDraft {
  id            String            @id @default(cuid())
  draftId       String
  type          DisplayTargetType
  valueText     String
  criterionText String
  included      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  draft DisplayCampaignDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, type])
}

model PerformanceMaxCampaignDraft {
  id                         String                          @id @default(cuid())
  organizationId             String
  clientId                   String
  externalAccountId          String
  createdById                String
  name                       String
  dailyBudgetMicros          BigInt
  biddingStrategy            PerformanceMaxBiddingStrategy   @default(MAXIMIZE_CONVERSIONS)
  targetCpaMicros            BigInt?
  targetRoasText             String?
  urlExpansionOptOut         Boolean                         @default(false)
  brandGuidelinesEnabled     Boolean                         @default(false)
  merchantCenterId           String?
  startDate                  String?
  endDate                    String?
  statusDraft                PerformanceMaxDraftStatus       @default(DRAFT)
  googleCampaignResourceName String?
  campaignOpId               String?
  notesText                  String?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt

  organization     Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client                          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  externalAccount  ExternalAccount                 @relation(fields: [externalAccountId], references: [id], onDelete: Restrict)
  createdBy        User                            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  campaignOps      CampaignOp[]
  assetGroups      PerformanceMaxAssetGroupDraft[]
  targets          PerformanceMaxTargetDraft[]
  signals          PerformanceMaxSignalDraft[]
  assistantThreads AssistantThread[]

  @@index([organizationId, statusDraft])
  @@index([clientId])
  @@index([externalAccountId])
  @@index([createdById])
}

model PerformanceMaxAssetGroupDraft {
  id                          String   @id @default(cuid())
  draftId                     String
  name                        String
  finalUrl                    String
  headlinesText               String
  longHeadlinesText           String
