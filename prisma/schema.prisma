model AssistantThread {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  draftId          String?
  displayDraftId   String?
  pmaxDraftId      String?
  demandGenDraftId String?
  videoDraftId     String?
  shoppingDraftId  String?
  createdById      String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draft          SearchCampaignDraft?          @relation(fields: [draftId], references: [id], onDelete: SetNull)
  displayDraft   DisplayCampaignDraft?         @relation(fields: [displayDraftId], references: [id], onDelete: SetNull)
