  shoppingDraft  ShoppingCampaignDraft?        @relation(fields: [shoppingDraftId], references: [id], onDelete: SetNull)
  createdBy      User                          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  messages       AssistantMessage[]

  @@index([organizationId, clientId])
  @@index([clientId, draftId])
  @@index([clientId, displayDraftId])
  @@index([clientId, pmaxDraftId])
  @@index([clientId, demandGenDraftId])
  @@index([clientId, videoDraftId])
  @@index([clientId, shoppingDraftId])
  @@index([createdById])
}

